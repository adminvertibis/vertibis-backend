# Option 1: full connection string (Railway / Neon / Render)
DATABASE_URL=postgresql://user:password@host:5432/vertibis

# Option 2: individual vars (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vertibis
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=

# Directory to store uploaded files locally
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=15728640
MAX_REQUEST_BYTES=15728640
ENABLE_LEGACY_UPLOAD_FLOW=false

# Optional: Anthropic API key for LLM advisories
ANTHROPIC_API_KEY=

# Optional: outbound email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@vertibis.in
ADMIN_EMAIL=admin@vertibis.in
ADMIN_PASSWORD=
ADMIN_JWT_EXPIRE_HOURS=8
FRONTEND_LOGIN_URL=https://your-frontend-domain/login

# Optional: CharteredInfo / TaxPro GST Return API integration.
GST_API_REMOTE_ENABLED=true
GST_API_ENV=sandbox
GST_SANDBOX_BASE_URL=https://gstsandbox.charteredinfo.com
GST_PROD_BASE_URL=https://gstapi.charteredinfo.com
GST_ASP_ID=
GST_ASP_PASSWORD=
GST_API_COST_PER_CALL=10
GST_TIMEOUT_SECONDS=30
GST_TOKEN_SECRET=
CONSENT_LINK_BASE_URL=
CONSENT_TOKEN_TTL_DAYS=30
