# Option 1: full connection string (Railway / Neon / Render)
DATABASE_URL=postgresql://user:password@host:5432/vertibis

# Option 2: individual vars (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vertibis
DB_USER=postgres
DB_PASSWORD=postgres

# Directory to store uploaded files locally
UPLOAD_DIR=uploads

# Optional: Anthropic API key for LLM advisories
ANTHROPIC_API_KEY=

# Optional: outbound email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@vertibis.in
ADMIN_EMAIL=admin@vertibis.in
FRONTEND_LOGIN_URL=https://your-frontend-domain/login

# Optional: TaxPro / CharteredInfo E-way Bill sandbox integration.
# Keep remote disabled until ASP ID/password are available.
TAXPRO_EWB_REMOTE_ENABLED=false
TAXPRO_EWB_MODE=sandbox
TAXPRO_EWB_SANDBOX_BASE_URL=https://gstsandbox.charteredinfo.com/ewaybillapi/dec/v1.03
TAXPRO_EWB_PRIMARY_BASE_URL=https://einvapi.charteredinfo.com/v1.03/dec
TAXPRO_EWB_BACKUP1_BASE_URL=https://einvapimum1.charteredinfo.com/v1.03/dec
TAXPRO_EWB_BACKUP2_BASE_URL=https://einvapidel2.charteredinfo.com/v1.03/dec
TAXPRO_EWB_ASP_ID=
TAXPRO_EWB_ASP_PASSWORD=
TAXPRO_EWB_GSTIN=
TAXPRO_EWB_USERNAME=
TAXPRO_EWB_PASSWORD=
TAXPRO_EWB_TIMEOUT_SECONDS=20
